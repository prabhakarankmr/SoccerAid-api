# See BACKEND_INSTRUCTIONS.md §11 — every key here must exist in src/config/env.schema.ts

NODE_ENV=development
PORT=3000

# Neon Postgres
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Redis (Railway Redis plugin locally: redis://localhost:6379)
REDIS_URL="redis://localhost:6379"

# Auth — access token is short-lived (JWT_ACCESS_TTL); the refresh token has no TTL of its own
# (session lasts until logout/revocation — see BACKEND_INSTRUCTIONS.md §9.5)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"

# OTP provider (MSG91 / Twilio)
OTP_PROVIDER="MSG91"
OTP_API_KEY="change-me"

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:19006"

# Push notifications (Expo)
EXPO_ACCESS_TOKEN="change-me"

# Logging
LOG_LEVEL="debug"
