# See BACKEND_INSTRUCTIONS.md §11 — every key here must exist in src/config/env.schema.ts

NODE_ENV=development
PORT=3000

# Neon Postgres
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Redis (Railway Redis plugin locally: redis://localhost:6379)
REDIS_URL="redis://localhost:6379"

# Auth — access token is short-lived (JWT_ACCESS_TTL); the refresh token has no TTL of its own
# (session lasts until logout/revocation — see BACKEND_INSTRUCTIONS.md §9.5)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"

# OTP provider (MSG91 / Twilio) — unused for now, see §9.5 flag: Firebase Phone Auth handles
# OTP send/verify instead until this is revisited. Still required to boot (schema below).
OTP_PROVIDER="MSG91"
OTP_API_KEY="change-me"

# Firebase Admin — verifies the ID token the app gets back from Firebase Phone Auth.
# Firebase Console → Project settings → Service accounts → Generate new private key.
# FIREBASE_PRIVATE_KEY: paste the PEM as one line with \n literal escapes (keep the quotes).
FIREBASE_PROJECT_ID="change-me"
FIREBASE_CLIENT_EMAIL="change-me@change-me.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nchange-me\n-----END PRIVATE KEY-----\n"

# CORS — :3000 is the API calling itself (Swagger etc.), :19006 is the old Expo-webpack web
# port, :8081/:8082 are current Expo CLI's Metro web dev server (picks 8082 if 8081 is busy)
CORS_ORIGINS="http://localhost:3000,http://localhost:19006,http://localhost:8081,http://localhost:8082"

# Push notifications (Expo)
EXPO_ACCESS_TOKEN="change-me"

# Logging
LOG_LEVEL="debug"
